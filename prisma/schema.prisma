// use prisma-8

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String
  type        String
  amount      Float
  date        TimestamptzString @default(now())
  description String
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Budget {
  id           String            @id @default(uuid())
  userId       String
  month        Int
  year         Int
  targetAmount Float
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([userId, month, year])
}
